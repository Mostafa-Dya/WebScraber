# Copy to .env and fill in. Never commit .env. See docs/SHEET_SETUP.md and docs/ADR.md D3/D9.

# --- Google Sheet (configuration, not a secret) ---
# Leave empty on first run: `npm run sheet:init` creates a development spreadsheet and fills this in.
GOOGLE_SHEET_ID=

# --- Google auth: one of the two modes ---
# service_account : GOOGLE_SERVICE_ACCOUNT_EMAIL + GOOGLE_PRIVATE_KEY (production default, ADR D3)
# oauth_refresh   : GOOGLE_OAUTH_CLIENT_ID/SECRET + GOOGLE_OAUTH_REFRESH_TOKEN (development, or when
#                   the Google Cloud organisation blocks service-account keys). The consenting account
#                   must be a dedicated least-privilege account (ADR D3), never the studio owner's.
GOOGLE_AUTH_MODE=service_account

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM with literal \n sequences on one line, or as a multi-line double-quoted value.
GOOGLE_PRIVATE_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional now. Connecting from /admin/google stores the refresh token in DATA_DIR and takes
# precedence over this value, so a value here is only a fallback for a deployment with no writable
# directory. `npm run google:auth` still fills it in for a laptop.
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Site secrets (at least 32 characters each; the app refuses to start otherwise) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=
VOTE_SALT=

# --- Runtime configuration ---
SHEETS_CACHE_TTL=60
# Directory for the last-good snapshot, the image mirror and the Google refresh token stored by
# /admin/google. Without it a Google account connected from the admin is lost on restart.
DATA_DIR=
# Header the HOST overwrites with the real client IP. Leave empty unless the platform documents one
# (DigitalOcean App Platform: do-connecting-ip); a client could send it itself on other hosts.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1
# Public origin of the site (REQUIRED): https decides the Secure/__Host- cookie and the same-origin check.
SITE_URL=http://localhost:4321

# --- Admin panel (docs/ADMIN_SPEC.md §9). Leave ADMIN_PASSWORD_HASH empty to keep /admin disabled. ---
# Generate with: npm run admin:password   (prompts for the password, prints the hash; --write stores it here)
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SESSION_SECRET=
ADMIN_USER=owner
# Optional retail multiplier used when the Settings tab has none (e.g. 1.6). Keep here if it is confidential.
RETAIL_MARKUP=
# Drive folder for imported photos (created and printed on first import when empty; needs the drive.file scope, SHEET_SETUP §6)
GOOGLE_DRIVE_FOLDER_ID=
# Scraper fallbacks
SCRAPE_JINA_FALLBACK=true
SCRAPE_ECG_GRAPHQL=false
# Brief §11: honour each supplier's robots.txt. eCarpetGallery publishes "Disallow: /", so with
# this true a scrape of that supplier answers `blocked` before any request. Set it to false only for
# a supplier the studio has a relationship with, and record the decision.
SCRAPE_RESPECT_ROBOTS=true

# --- Customer realm and FX (brief §8, §10) ---
# Signs the per-customer session cookies. Leave empty to keep /{slug} disabled (404).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUTH_SECRET=
# Keeps the public catalogue (/, /rugs/*, /tags/*) reachable without a customer session. Set it to
# false for the brief's posture, where the site serves only /{slug} and /admin (§10).
PUBLIC_CATALOGUE=true
# All prices are stored in this currency; every other currency is derived (brief §8).
BASE_CURRENCY=USD
# Daily rates, cached in memory with a hardcoded fallback table in code.
FX_API_URL=https://api.frankfurter.dev/v1/latest
FX_REFRESH_HOURS=24
