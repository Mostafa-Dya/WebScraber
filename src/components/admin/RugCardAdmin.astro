---
// Catalogue card for the admin list (docs/ADMIN_SPEC.md §8.3, legacy renderCatalogue()): photo with
// the rotate logic (`data-rot`, class added on load by rug-list.ts), count badge, name, meta, price,
// status chip. The whole card links to the edit page. Filtering keys on the data attributes.
import type { AdminRug } from '../../lib/admin/read.ts';
import { driveImageUrl } from '../../lib/images.ts';
import { dataRot } from '../../lib/rotate.ts';
import { dims } from '../../lib/units.ts';
import { collectionSlug, collectionSlugs } from '../../lib/text.ts';
import { badgesFor } from '../../lib/view.ts';
import type { Collection } from '../../lib/sheets/types.ts';

interface Props {
  rug: AdminRug;
  collections: readonly Collection[];
}
const { rug, collections } = Astro.props;
const photo = rug.photos[0] ? driveImageUrl(rug.photos[0], 800) : undefined;
// Size only. With material, age and origin here too, a fully-filled rug ran four lines longer than
// a sparse one, so the grid rows went ragged and the plates below them never lined up. Figma's card
// carries id, title, size and price; the rest is one click away on the rug's own page.
const meta = [dims(rug.widthCm, rug.lengthCm, 'cm')].filter(Boolean);
const price = rug.priceUsd ? `$${rug.priceUsd.toLocaleString('en-US')}` : '';
const slug = rug.collection.trim() ? collectionSlug(rug.collection, collections) : '';
// Every slug the rug belongs to, so one chip filter drives cards and rows alike.
const slugs = rug.collections.length ? collectionSlugs(rug.collections, collections).join(' ') : '';
// Figma's "All sources" dropdown, delivered without a control: `supplier` is a two-value enum
// (dto.ts), so a 180px select for two options is furniture — typing "karavan" is faster, and it also
// matches the supplier's own reference. A haystack, never markup.
const search = [rug.name, rug.id, rug.supplierRef, rug.slug, rug.supplier]
  .join(' ')
  .toLowerCase()
  .replace(/[<>]/g, ' ');
// The same corner badge the buyer sees (owner, 2026-09-13), so the owner is looking at their
// catalogue the way their customer will.
const badges = badgesFor(rug.tags);
---

<a
  href={`/admin/rugs/${encodeURIComponent(rug.id)}`}
  class:list={['card', `status-${rug.status}`]}
  data-card
  data-id={rug.id}
  data-collection={slug}
  data-collections={slugs}
  data-status={rug.status}
  data-attention={rug.commitStatus === 'pending' ? 'photos' : ''}
  data-search={search}
>
  <div class="ph">
    {photo ? <img src={photo} alt="" loading="lazy" data-rot={dataRot(rug.rotate)} /> : <span>no photo</span>}
    {rug.photos.length > 1 && <span class="cnt">{rug.photos.length}</span>}
    {
      badges.length > 0 && (
        <ul class="badges">
          {badges.map((b) => (
            <li class="badge-corner">{b}</li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="nm">{rug.name}</div>
  <div class="mt">
    <span class="mono">{rug.id}</span>
    {meta.map((m) => <span class="line">{m}</span>)}
  </div>
  {price && <div class="pr">{price}</div>}
  <div class:list={['status', rug.status]}>{rug.status}</div>
  {
    /* Brief §12: a row whose photo import did not finish says so, and the list offers to finish it.
       The button sits outside the card's own link, so pressing it does not navigate. */
    rug.commitStatus === 'pending' && (
      <div class="pending">
        <span class="status revoked">photos pending</span>
      </div>
    )
  }
</a>
{
  rug.commitStatus === 'pending' && (
    <button type="button" class="chip retry" data-retry={rug.id}>
      Finish photo import
    </button>
  )
}

<style>
  .pending {
    margin-top: 4px;
  }
  .retry {
    margin-top: 4px;
  }
</style>
