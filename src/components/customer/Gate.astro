---
// The password gate a buyer meets at `/{slug}` before they have a session (brief §7, §10).
//
// It greets them by name — the display name is the one thing the gate reveals, because the link was
// sent to them personally and a nameless password box reads like a phishing page. The password
// itself was generated by the studio and read to them; there is no account, no reset and no
// username, so the form is one field.
interface Props {
  slug: string;
  displayName: string;
}
const { slug, displayName } = Astro.props;
---

<main class="gate">
  <section class="gate-card">
    <p class="eyebrow">Serio Ludere</p>
    <h1 class="gate-title">Welcome, {displayName}.</h1>
    <p class="gate-lede">
      This preview was put together for you. Enter the password the studio sent with your link.
    </p>
    <form class="gate-form" method="post" action={`/api/customers/${slug}/login`} data-gate={slug}>
      <label class="gate-label" for="gate-password">Password</label>
      <input
        id="gate-password"
        name="password"
        type="password"
        autocomplete="current-password"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        required
        maxlength="200"
      />
      <button type="submit" class="gate-submit" data-gate-submit>Open my preview</button>
      <p class="gate-error" data-gate-error role="alert" hidden></p>
    </form>
  </section>
</main>

<style>
  .gate {
    display: grid;
    place-items: center;
    min-height: 70vh;
    padding: 24px;
  }
  .gate-card {
    width: 100%;
    max-width: 440px;
  }
  .gate-title {
    font-size: 28.8px;
    line-height: 1.15;
    font-weight: 500;
    margin: 6px 0 10px;
  }
  .gate-lede {
    color: var(--ink-soft);
    margin-bottom: 20px;
  }
  .gate-form {
    display: grid;
    gap: 8px;
  }
  .gate-label {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }
  .gate-form input {
    font: inherit;
    padding: 10.4px 12.8px;
    border: 1px solid var(--rule, #ddd8c4);
    border-radius: 0;
    background: var(--paper-deep, #fffff5);
    color: inherit;
  }
  .gate-submit {
    font: inherit;
    padding: 10.4px 12.8px;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    background: var(--ink, #141413);
    color: var(--paper, #fefcf0);
  }
  .gate-submit[aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
  }
  .gate-error {
    color: var(--danger, #cb2b2b);
    font-size: 13px;
  }
</style>

<script>
  import { initGate } from '../../scripts/gate.ts';
  initGate();
</script>
