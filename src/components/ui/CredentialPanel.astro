---
// Credential Panel — Figma 20:91. The reveal-once panel shown when a customer link is created.
//
// The border is 2px, deliberately the same weight as a focus ring, which makes this the loudest
// surface in the admin. One button copies BOTH the URL and the password together — two separate
// copies is how half a credential gets pasted into a message.
//
// The password is rendered as text because this is the only time it is ever shown; there is nothing
// to reveal later. The warning says so in the copy, verbatim from the file.
//
// `url` and `password` may be empty at render: on /admin/clients the values only exist in the
// create/reset RESPONSE, so the panel ships blank and clients.ts fills the two [data-credential-*]
// spans and re-points each [data-copy] control. `data-copy-what` is how it knows which is which.
import Icon from './Icon.astro';
import Button from './Button.astro';

interface Props {
  url: string;
  password: string;
  title?: string;
  class?: string;
}
const { url, password, title = 'Link created', class: className } = Astro.props;
---

<section class:list={['credential', className]} aria-label={title}>
  <div class="credential__head">
    <h2 class="credential__title">{title}</h2>
    <p class="credential__note">This is the only time the password is shown.</p>
  </div>

  <div class="credential__field">
    <span class="credential__label" id="cred-url-label">Preview URL</span>
    <div class="credential__value">
      <span data-credential-url>{url}</span>
      <button
        type="button"
        class="credential__copy"
        data-copy={url}
        data-copy-what="url"
        aria-describedby="cred-url-label"
      >
        <Icon name="copy" />
        <span class="sr-only">Copy preview URL</span>
      </button>
    </div>
  </div>

  <div class="credential__field">
    <span class="credential__label" id="cred-pw-label">Password</span>
    <div class="credential__value">
      <span data-credential-password>{password}</span>
      <button
        type="button"
        class="credential__copy"
        data-copy={password}
        data-copy-what="password"
        aria-describedby="cred-pw-label"
      >
        <Icon name="copy" />
        <span class="sr-only">Copy password</span>
      </button>
    </div>
  </div>

  <p class="credential__warning">
    <Icon name="alert" />
    <span>
      Once you close this, the password can only be regenerated — which stops the old one working.
    </span>
  </p>

  <Button style="primary" data-copy={`${url}\n${password}`} class="credential__both">
    Copy link and password
  </Button>
</section>
